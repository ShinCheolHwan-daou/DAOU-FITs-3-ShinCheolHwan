<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.mappers.members">
    <select id="selectMemberByIdAndPassword" parameterType="Map" resultType="Member">
        <![CDATA[
        SELECT *
        FROM MEMBERS
        WHERE ID = #{id}
          AND PASSWORD = #{password}
        ]]>
    </select>
</mapper>